{
  "name": "TradingAgents Studio Web Cockpit",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "TradingAgents Studio Web UI",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -e .",
  "postStartCommand": "nohup python run_web.py --host 0.0.0.0 --port 8000 > web_server.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
